#!/bin/sh
# commit 前の手元ゲート（product-baseline §5）。
#
# **2026-09-24 に、これが無いまま `cargo fmt` を掛けずに commit して CI を落としました**
# （814909f・`core` が 3 OS すべてで format 落ち）。手元では test と clippy を
# 走らせていたので「緑」に見えていた ——「自分の緑を信じる」の型です。
#
# **ここに入れるのは速いものだけ。**clippy と test は分単位かかるので入れません。
# 遅いゲートは必ず `--no-verify` で外されるようになり、そのとき fmt も一緒に外れます。
# 重い面は CI が最終ゲート（§5）。

set -e

if ! command -v cargo >/dev/null 2>&1; then
  if [ -x "$HOME/.cargo/bin/cargo" ]; then
    PATH="$HOME/.cargo/bin:$PATH"
    export PATH
  else
    echo "pre-commit: cargo が見つかりません。fmt を確かめずに通します。" >&2
    echo "pre-commit: **CI の format が最終ゲートです。**" >&2
    exit 0
  fi
fi

# **色の名前。**`var(--typo)` は黙って当たらないので、機械に見させる（D59）。
# python3 が無い席では飛ばす —— **黙ってではなく、そう言って飛ばす**（§5）。
if command -v python3 >/dev/null 2>&1; then
  if ! python3 tools/check-css-tokens.py >/dev/null; then
    python3 tools/check-css-tokens.py || true
    echo "" >&2
    echo "pre-commit: **使っていない色の名前があります。**上を直してください。" >&2
    exit 1
  fi
  # **Windows の既定の文字コードで死なないか。**
  #
  # 2026-09-25、`check-css-tokens.py` 自身が **Windows の CI を落としました** ——
  # あちらの Python は標準出力の既定が cp1252 で、**日本語を 1 文字出した瞬間に
  # `UnicodeEncodeError` で死にます。**こちらは macOS でしか試していませんでした。
  #
  # **ここで同じ条件を作ります。**出力は捨てて、死ぬかどうかだけ見ます。
  for _t in tools/check-css-tokens.py tools/check-css-contrast.py tools/make-site-tools.py \
            tools/check-bundle-assets.py; do
    # **検査の言い分を捨てない**（§8）。捨てていたので、
    # 「道具の分類漏れ」を**「Windows の文字コードで死にます」と言っていました** ——
    # 嘘の理由は、理由が無いより悪い（2026-10-02 に実際に迷いました）。
    if ! _said=$(PYTHONIOENCODING=cp1252 python3 "$_t" 2>&1); then
      echo "pre-commit: **$_t が止めました。**" >&2
      echo "$_said" >&2
      echo "pre-commit: 確かめ方 — PYTHONIOENCODING=cp1252 python3 $_t" >&2
      exit 1
    fi
  done

  if ! python3 tools/check-css-contrast.py >/dev/null; then
    python3 tools/check-css-contrast.py || true
    echo "" >&2
    echo "pre-commit: **字と地の対比が足りません。**上を直してください。" >&2
    exit 1
  fi
else
  echo "pre-commit: python3 が無いので色の名前は確かめません。**CI が最終ゲートです。**" >&2
fi

if ! cargo fmt --all -- --check; then
  echo "" >&2
  echo "pre-commit: **整形が合っていません。**上の差分が CI の format で落ちます。" >&2
  echo "pre-commit: 直し方 — cargo fmt --all" >&2
  exit 1
fi

# **作業の記録が git に入っていないか。**語の検査とは別に要る（記録は文面が中立でも、
# 公開リポに置く理由が無い）。`git ls-files` 1 回で **40 ミリ秒**。
if ! bash .github/scripts/oss-placement-check.sh >/dev/null 2>&1; then
  bash .github/scripts/oss-placement-check.sh >&2
  exit 1
fi

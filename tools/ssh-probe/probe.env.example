# 探り棒へ接続先を渡すためのファイル。
#
#   cp probe.env.example probe.env
#   （probe.env を編集する。**gitignore 済みなので commit されません**）
#   set -a; . ./probe.env; set +a
#   cargo run --release -- --offer-only
#
# **なぜファイルにするか**: コマンドラインに書くと、シェルの履歴と
# `ps` の出力に接続先が残ります。この製品は接続先をどこにも残しません（PRD §8）。
#
# **値はここに書かないでください。**この example には変数名だけを置きます
# （product-baseline §14）。

# 必須。ホスト名か IP
SSHBOARD_PROBE_HOST=

# 省略可（既定 22）
SSHBOARD_PROBE_PORT=

# --offer-only 以外では必須
SSHBOARD_PROBE_USER=

# 省略すると ssh-agent を使う。**推奨は ssh-agent（鍵をアプリに渡さない）**
SSHBOARD_PROBE_KEY=

# sftp の ls を試すパス。省略すると "."
SSHBOARD_PROBE_SFTP_PATH=

# 文字コードを見たいファイル（ログや設定ファイル）。中身は出力されない
SSHBOARD_PROBE_SNIFF=

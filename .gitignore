# Node / SvelteKit
node_modules/
.svelte-kit/
dist/
build/
coverage/

# Rust / Tauri
# 中間にスラッシュを含むパターンはリポジトリルート固定になる。
# apps/ の下にも src-tauri があるので ** を付ける。
target/
**/src-tauri/target/
**/src-tauri/gen/

# 環境
.env
.env.local
*.log
.DS_Store

# ローカル秘密控え（🟡 識別子のみ・🔴 token/key は置かない）— commit 禁止
SECRETS.local.md

# ベースルール完全版（内部事例を含むため公開しない）— commit 禁止
.claude/rules/product-baseline.full.md

# 手元のテスト用サーバーの使い捨て鍵 — commit 禁止
tools/test-server/.key
tools/test-server/.key.pub

# 探り棒へ渡す接続先 — commit 禁止
probe.env
**/probe.env

# 接続先の控え — commit 禁止
# 本製品は画面そのものに接続先が写り込む。ホスト名 / IP / ユーザー名を
# リポジトリへ入れない（PRD §8）。
connections.local.json
*.known_hosts

# 画面のキャプチャ（D26）。**リポジトリへ置かない。**
# commit history に焼き付くと、出す前しか対策できない（PRD §8）。
*.png
*.jpg
*.gif
!apps/desktop/src/lib/assets/*

# `tauri icon` が作るが、この製品では使わないもの。
# 対象は Windows と macOS だけ（PRD §7）。`tools/make-icons.sh` が片付けています。
apps/desktop/src-tauri/icons/android/
apps/desktop/src-tauri/icons/ios/
